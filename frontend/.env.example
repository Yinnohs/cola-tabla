# Origen del backend. Vacio = mismo origen (en dev, Vite proxea /api -> http://localhost:8080; en prod, nginx /api).
VITE_API_BASE_URL=

# Login OIDC (Authorization Code + PKCE) contra Keycloak. Valores de desarrollo (infra/docker-compose.yml);
# usuarios de prueba: owner/owner, editor/editor, viewer/viewer. Si se omiten, se usan estos mismos valores.
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/kanban
VITE_OIDC_CLIENT_ID=kanban-web
# Opcionales: por defecto <origen>/auth/callback y <origen>/auth/signed-out. Deben estar permitidas en el cliente
# kanban-web (redirectUris / post.logout.redirect.uris de infra/keycloak/realm.json: :5173 y :8000).
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/auth/signed-out
