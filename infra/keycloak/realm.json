{
  "realm": "kanban",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      { "name": "owner", "description": "Propietario de workspace (dev)" },
      { "name": "editor", "description": "Editor (dev)" },
      { "name": "viewer", "description": "Solo lectura (dev)" }
    ]
  },
  "clients": [
    {
      "clientId": "kanban-web",
      "name": "Kanban Web (SPA)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:5173/*", "http://localhost:8000/*"],
      "webOrigins": ["http://localhost:5173", "http://localhost:8000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:8000/*"
      }
    },
    {
      "clientId": "kanban-dev-cli",
      "name": "Kanban Dev CLI (SOLO desarrollo local: password grant para curl/tests manuales)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "kanban-api",
      "name": "Kanban API (resource server)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "id": "00000000-0000-0000-0000-00000000a001",
      "username": "owner",
      "email": "owner@kanban.local",
      "firstName": "Olivia",
      "lastName": "Owner",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "owner", "temporary": false }],
      "realmRoles": ["owner", "offline_access"]
    },
    {
      "id": "00000000-0000-0000-0000-00000000a002",
      "username": "editor",
      "email": "editor@kanban.local",
      "firstName": "Edgar",
      "lastName": "Editor",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "editor", "temporary": false }],
      "realmRoles": ["editor", "offline_access"]
    },
    {
      "id": "00000000-0000-0000-0000-00000000a003",
      "username": "viewer",
      "email": "viewer@kanban.local",
      "firstName": "Vera",
      "lastName": "Viewer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "viewer", "temporary": false }],
      "realmRoles": ["viewer", "offline_access"]
    }
  ]
}
